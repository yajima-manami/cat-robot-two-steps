#!/usr/bin/env python3
"""ROS 2 Humble: publish two forward and two backward motion intervals to /cmd_vel.
Run only with a Gazebo DiffDrive robot or another safe simulator connected.
"""
import time
import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist

class CatTwoSteps(Node):
    def __init__(self):
        super().__init__('cat_two_steps')
        self.pub = self.create_publisher(Twist, '/cmd_vel', 10)

    def move(self, speed, duration):
        end = time.monotonic() + duration
        while rclpy.ok() and time.monotonic() < end:
            msg = Twist()
            msg.linear.x = speed
            self.pub.publish(msg)
            time.sleep(0.05)
        self.stop()

    def stop(self):
        self.pub.publish(Twist())
        time.sleep(0.2)

    def run(self):
        time.sleep(1.0)  # allow discovery
        for direction, speed in [('前進', 0.15), ('後退', -0.15)]:
            for step in (1, 2):
                self.get_logger().info(f'{direction} {step}歩目（時間区間）')
                self.move(speed, 1.0)
                self.stop()
        self.get_logger().info('完了')

def main():
    rclpy.init()
    node = CatTwoSteps()
    try:
        node.run()
    except KeyboardInterrupt:
        pass
    finally:
        node.stop()
        node.destroy_node()
        rclpy.shutdown()

if __name__ == '__main__':
    main()

